#!/usr/bin/env bash
set -Eeuo pipefail

MESSAGE_FILE="$1"
SUBJECT="$(head -n 1 "${MESSAGE_FILE}")"
PATTERN='^(feat|fix|docs|test|refactor|perf|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,72}$'

if [[ ! "${SUBJECT}" =~ ${PATTERN} ]]; then
  printf 'Commit subject is not conventional: %s\n' "${SUBJECT}" >&2
  printf 'Expected: type(scope): imperative summary (maximum 72 characters)\n' >&2
  exit 1
fi
